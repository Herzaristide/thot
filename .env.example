# =============================================================================
# Thot — variables d'environnement (copier vers .env)
# =============================================================================

# --- PostgreSQL ---
POSTGRES_USER=thot
POSTGRES_PASSWORD=change-me
POSTGRES_DB=thot
POSTGRES_PORT=5432
# URL de connexion applicative (dans un conteneur du même réseau, host = postgres)
DATABASE_URL=postgresql://thot:change-me@localhost:5432/thot

# --- Qdrant ---
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=books

# --- Embeddings ---
EMBEDDING_MODEL=intfloat/multilingual-e5-large
VECTOR_SIZE=1024

# --- pgAdmin (visualisation du schéma / ERD Tool) ---
PGADMIN_DEFAULT_EMAIL=admin@thot.dev
PGADMIN_DEFAULT_PASSWORD=change-me
PGADMIN_PORT=5050

# --- MinIO (stockage EPUB + photos de profil) ---
MINIO_ROOT_USER=thot
MINIO_ROOT_PASSWORD=change-me
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ENDPOINT=http://localhost:9000
MINIO_BOOKS_BUCKET=books
MINIO_AVATARS_BUCKET=avatars
