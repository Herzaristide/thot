# =============================================================================
# Thot — variables d'environnement (copier vers .env)
# =============================================================================

# --- PostgreSQL ---
POSTGRES_USER=thot
POSTGRES_PASSWORD=change-me
POSTGRES_DB=thot
POSTGRES_PORT=5432
# URL de connexion applicative (dans un conteneur du même réseau, host = postgres).
# sslmode=disable : requis par dbmate (migrations) avec un Postgres local sans TLS.
DATABASE_URL=postgresql://thot:change-me@localhost:5432/thot?sslmode=disable

# --- Qdrant ---
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
# Alias Qdrant interrogé par l'API ; pointe vers la collection de l'index actif
QDRANT_COLLECTION=chunks

# --- Ingestion (ingest/) ---
# Dossier des livres : books/<auteur>/<œuvre>/work.toml + <langue>.epub
BOOKS_DIR=./books
# Dense : modèle par défaut des nouveaux index (thot index create).
# Le sparse (BM25, racinisation selon la langue de l'édition) est calculé sur CPU.
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
VECTOR_SIZE=1024
# Modèle d'alignement des traductions (thot align)
ALIGN_MODEL=sentence-transformers/LaBSE
# cuda, cpu ou vide (= cuda si disponible)
DEVICE=
# Chunks vectorisés par lot (baisser si le GPU manque de mémoire)
EMBED_BATCH_SIZE=32

# --- Keycloak (identité, realm `thot` importé depuis keycloak/import/) ---
KEYCLOAK_PORT=8080
# URL publique : émetteur des jetons (iss) vu par les navigateurs et les apps
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me
# Utilisateur de développement `lecteur` (corpus:read, review, admin)
KEYCLOAK_DEV_USER_PASSWORD=lecteur

# --- Liseuse (reader/, client Keycloak `thot-reader`) ---
READER_URL=http://localhost:3000
READER_CLIENT_SECRET=dev-reader-secret
READER_PORT=3000
# Secret des sessions de la liseuse (openssl rand -base64 32)
READER_AUTH_SECRET=change-me-change-me-change-me-change-me
# Corpus API vue depuis le conteneur de la liseuse
CORPUS_API_URL=http://api:8000
# Période de synchronisation du worker /v1/changes (secondes)
READER_WORKER_INTERVAL=60

# --- Corpus API (corpus-api/) ---
API_PORT=8000
# Keycloak : URL du realm (émetteur des jetons) et audience attendue
OIDC_ISSUER=http://localhost:8080/realms/thot
OIDC_AUDIENCE=corpus-api
# DÉVELOPPEMENT UNIQUEMENT : aucun jeton vérifié, tous les droits
AUTH_DISABLED=false
# Encodeur des requêtes : cuda, cpu ou vide (= cuda si disponible)
API_DEVICE=
# Origines autorisées à appeler l'API depuis un navigateur (JSON)
CORS_ORIGINS=[]
# 1 une fois les modèles en cache : évite ~40 s de vérifications en ligne au démarrage
HF_HUB_OFFLINE=0

# --- pgAdmin (visualisation du schéma / ERD Tool) ---
PGADMIN_DEFAULT_EMAIL=admin@thot.dev
PGADMIN_DEFAULT_PASSWORD=change-me
PGADMIN_PORT=5050

# --- MinIO (fichiers EPUB des éditions) ---
MINIO_ROOT_USER=thot
MINIO_ROOT_PASSWORD=change-me
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
# Vide = l'ingestion n'envoie pas les EPUB (l'API ne pourra pas les servir)
MINIO_ENDPOINT=http://localhost:9000
MINIO_BOOKS_BUCKET=books
