{
  "realm": "thot",
  "displayName": "Thot",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": true,
  "registrationEmailAsUsername": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "rememberMe": true,
  "verifyEmail": false,
  "bruteForceProtected": true,
  "internationalizationEnabled": true,
  "supportedLocales": ["fr", "en"],
  "defaultLocale": "fr",
  "loginTheme": "thot",
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 604800,
  "ssoSessionMaxLifespan": 2592000,
  "ssoSessionIdleTimeoutRememberMe": 2592000,
  "ssoSessionMaxLifespanRememberMe": 7776000,
  "roles": {
    "client": {
      "corpus-api": [
        { "name": "corpus:read", "description": "Catalogue, texte des éditions accessibles, recherche, alignements" },
        { "name": "corpus:review", "description": "Verdicts et corrections d'alignement (jeton utilisateur)" },
        { "name": "corpus:admin", "description": "Éditions restricted, suivi des ingestions et des index" }
      ]
    }
  },
  "defaultRole": {
    "name": "default-roles-thot",
    "description": "Rôles attribués à tout nouvel utilisateur",
    "composite": true,
    "composites": {
      "realm": ["offline_access", "uma_authorization"],
      "client": {
        "account": ["view-profile", "manage-account"],
        "corpus-api": ["corpus:read"]
      }
    }
  },
  "clients": [
    {
      "clientId": "corpus-api",
      "name": "Corpus API",
      "description": "Ressource protégée : porte les rôles corpus:* et sert d'audience aux jetons",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "bearerOnly": false,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false
    },
    {
      "clientId": "thot-reader",
      "name": "Thot — liseuse",
      "description": "Application Next.js (BFF) : connexion des lecteurs et compte de service",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${THOT_READER_CLIENT_SECRET:dev-reader-secret}",
      "rootUrl": "${THOT_READER_URL:http://localhost:3000}",
      "baseUrl": "/",
      "redirectUris": ["${THOT_READER_URL:http://localhost:3000}/*"],
      "webOrigins": ["+"],
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "frontchannelLogout": true,
      "fullScopeAllowed": true,
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "${THOT_READER_URL:http://localhost:3000}/*"
      },
      "protocolMappers": [
        {
          "name": "audience corpus-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "corpus-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "service-account-thot-reader",
      "enabled": true,
      "serviceAccountClientId": "thot-reader",
      "clientRoles": {
        "corpus-api": ["corpus:read"]
      }
    },
    {
      "username": "lecteur",
      "email": "lecteur@thot.dev",
      "emailVerified": true,
      "firstName": "Lecteur",
      "lastName": "Thot",
      "enabled": true,
      "credentials": [
        { "type": "password", "value": "${THOT_DEV_USER_PASSWORD:lecteur}", "temporary": false }
      ],
      "realmRoles": ["default-roles-thot"],
      "clientRoles": {
        "corpus-api": ["corpus:read", "corpus:review", "corpus:admin"]
      }
    }
  ]
}
